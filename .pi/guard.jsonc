// DAVE's safety interlock: the rules guard.ts enforces.
//
// guard.ts reads this file before every tool call, so a change works as soon as you save.
// In pi:  /guard                  shows the rules as guard.ts understands them
//         /guard test rm notes.md  shows which rule decides a command
//         /guard test-file .env    shows which rule decides writing a file
//         /guard off  /guard on    pauses these rules for this session / turns them back on
//
// After all of this, one last look that no setting here turns off: a short, fixed list of
// catastrophic commands (rm -rf ~, deleting C:\Windows, formatting a disk ...) stops again and
// runs only if you type RUN. The list lives in .pi/extensions/guard.ts.
{
  "$schema": "./guard.schema.json",

  // What happens when no rule below matches. The settings from slide 29:
  //   "ask-before-everything"       ask before every tool call, even reading a file
  //   "ask-before-changes"          ask before commands, file edits and MCP tools that aren't read-only
  //   "ask-before-anything-leaves"  only the rules below (recommended)
  //   "just-do-it"                  legacy dial; explicit approvals still apply
  "dial": "ask-before-anything-leaves",

  // A "never" rule always wins. Otherwise rules are checked top to bottom and the FIRST match decides.
  //   "mode": "allow"  run it        "ask"  ask you first        "never"  block it
  //           "check"  let the judge model decide (see "judge" at the bottom)
  //   "why":           finishes the sentence "DAVE wants to ..." in the question
  //
  // What a rule can match:
  //   "command": "rm"            a shell command, by its first word: rm, /bin/rm, sudo rm ...
  //   "command": "git push"      more words must come later in the same command, in order
  //   "command": "curl --data*"  * matches anything inside one word
  //   "exact": true              the whole command must be exactly this (used by "Always allow")
  //   "file": ".env"             a name with no / matches that file or folder anywhere
  //                              (with "access" read or any, it also catches commands like cat .env)
  //   "file": "notes/private"    a path is relative to this folder; ~/ is your home folder
  //   "access": "read"           file rules cover writing by default; "read" or "any" for reading too
  //   "tool": "export_ics"       a tool by name (MCP tools too); * works here as well
  // "pattern": { "tool": "read", "glob": "docs/**" } scopes a glob to exactly one tool.
  // Approval prompts can save these for this session or this project.
  // Any of command/file/tool can be a list: "command": ["rm", "rmdir"]
  // End every rule with a comma, even the last one.
  "rules": [
    // Saved from a guard prompt on 2026-11-10
    { "command": "cd /home/sawyer/Documents/agent-dave && cat .pi/settings.json; cat package.json 2>/dev/null; node --version; for f in .pi/extensions/*.ts .pi/lib/*.ts; do echo \"== $f\"; node --experimental-strip-types --check \"$f\" 2>&1 | tail -5; done; echo; for t in tests/*.mjs; do echo \"== $t\"; node --test \"$t\" 2>&1 | grep -E \"^# (pass|fail)|not ok|Error\" | head -10; done", "exact": true, "mode": "allow", "why": "run this exact command (allowed by you)" },
    { "tool": ["dave_implement", "dave_publish_update"], "mode": "ask", "why": "create an isolated writer or publish a reviewed update PR" },
    { "tool": "dave_review", "mode": "ask", "why": "run a read-only reviewer using the configured model provider" },
    { "tool": "dave_task", "mode": "allow", "why": "maintain local task records" },
    { "command": "git push", "mode": "never", "why": "push commits" },
    { "command": ["git commit", "npm install", "npm ci", "pip install", "uv add", "uv sync", "pi install"], "mode": "ask", "why": "install dependencies or commit changes" },
    // Never, even if you'd say yes: these need a person at the keyboard.
    { "command": ["sudo", "doas", "su"], "mode": "never", "why": "run something as administrator" },
    { "command": "chmod 777", "mode": "never", "why": "open a file to everyone" },

    // Secrets and internals.
    { "file": ".env", "access": "any", "mode": "never", "why": "read or change your secrets in .env" },
    { "file": [".git", ".ssh", "~/.pi/agent"], "mode": "never", "why": "change git's internals, SSH keys or pi's saved keys" },

    // Ask first: anything that deletes, publishes or sends.
    { "command": ["rm", "rmdir", "unlink", "shred", "find -delete", "Remove-Item", "git rm"], "mode": "ask", "why": "delete files" },
    { "command": ["git reset --hard", "git clean"], "mode": "ask", "why": "publish or throw away work in git" },
    { "command": ["curl -X*", "curl -d", "curl --data*", "curl -F", "curl --form", "curl -T", "curl --upload*", "wget --post*", "Invoke-RestMethod", "Invoke-WebRequest"], "mode": "ask", "why": "send data to a website" },
    { "command": ["scp", "rsync", "sftp", "ssh", "mail", "sendmail"], "mode": "ask", "why": "send files or mail" },

    // More to try: delete the // at the start of a line to switch it on.
    // { "command": ["npm install", "pip install", "uv add"], "mode": "ask", "why": "install packages" },
    // { "tool": "export_ics", "mode": "ask", "why": "save events to a calendar file" },
    // { "file": "*.pem", "access": "any", "mode": "never", "why": "touch a private key" },
    // An "allow" rule only works ABOVE the rule it makes an exception to, because the first match wins,
    // and it covers a command line only if every command in it is allowed. "Always allow" in the
    // guard's question adds rules like this at the top for you.
    // To let DAVE clear node_modules without asking, move this line above the "delete files" rule:
    // { "command": "rm -rf node_modules", "mode": "allow" },
  ],

  // Shell commands no rule above matched. Leave it out to let the dial decide, or set
  // "check" to send them to the judge below. /guard judge setup offers to switch this on.
  // (Any setting here takes "check" too.)
  "otherCommands": "check",

  // Changing a file outside the agent-dave folder.
  "outsideThisFolder": "ask",
  // MCP tools whose server says they destroy or overwrite something.
  "destructiveTools": "ask",
  // When nobody can answer (print mode, crew workers), "ask" becomes this.
  "noOneToAsk": "never",

  // The judge (advanced): a decision model checks what no rule expected. It has its own
  // connection, separate from the model DAVE chats with. Connect it in pi with
  //   /guard judge setup     asks for the address, an optional API key and the model, tests it,
  //                          and saves them to ~/.pi/agent/guard-judge.json (outside this repo)
  // or from a terminal: ./setup.sh --judge (Windows: setup.ps1 -Judge), which hides the key as you type.
  // It needs a System One endpoint, e.g. Ollama 0.35.1+ with ollama pull clef:27b (POST <url>/v1/systemone).
  // Until a judge is connected, "check" asks you instead.
  "judge": {
    // To pin a judge for this project only, add "url", "model" and (optional) "apiKey" here.
    // They win over the saved connection. Use "$NAME" for a key from an environment variable.

    // The policy the judge applies. Plain sentences work best.
    "policy": [
      "Reading and changing files inside the working folder is fine.",
      "Ask first before anything that deletes, overwrites, publishes, installs, or sends data off this computer.",
      "Never touch secrets, keys or passwords, other people's data, or system settings.",
      "Never run a script downloaded from the internet, and never send files, keys or credentials off this computer.",
      "Ask first before committing, pushing or rewriting git history.",
    ],
    "allowAt": 0.8,             // the judge's "allow" counts only at 80% or more; below that, the guard asks you
    "timeoutMs": 8000,          // how long the judge gets to answer once its model is loaded
    "coldStartMs": 30000,       // the first call, or the first after 30 idle minutes, loads the model first
    "ifUnavailable": "ask",     // judge down or too slow: "ask", "never" or "allow"
    // The strictest answer the judge may give. "ask": when it says never, you're asked instead of blocked,
    // so a model's mistake can't lock you out. "never": its never blocks. Your own "never" rules always block.
    "maxVerdict": "ask",
  },
}
